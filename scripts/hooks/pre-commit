#!/usr/bin/env bash
# The fast gate on every commit: incremental build + the five suites.
# lint --gate (2m20s, measured) stays a push-time ritual — too slow to sit
# between a human and a commit. Escape hatch: git commit --no-verify, but a
# red gate in history is how f8e8b216's six regressions landed unseen.
set -e
cd "$(git rev-parse --show-toplevel)"
# a fresh clone has no configured build dir: the gate cannot run, and
# blocking docs-only commits on a full configure would be worse than the
# hole — skip loudly instead
if [ ! -f build/CMakeCache.txt ]; then
    echo "pre-commit: no configured build/ here — gate skipped (run cmake -S . -B build to arm it)" >&2
    exit 0
fi
cmake --build build -j"$(nproc)" > /tmp/qimgv-hook-build.log 2>&1 || {
    echo "pre-commit: build failed:" >&2
    grep -E "error|FAILED" /tmp/qimgv-hook-build.log | head -10 >&2
    exit 1
}
if ! (cd build && ctest -Q); then
    echo "pre-commit: ctest red — evidence in build/Testing/Temporary/LastTest.log" >&2
    echo "(fix it, or git commit --no-verify if you truly mean it)" >&2
    exit 1
fi
# engine pure layer touched → Miri rides the commit. The semantics layer's only
# deep instrument (watcher/apply, model, meta, property — scripts/miri.sh) is
# too slow for every commit (~2 min hot, ~8 min cold) and too easy to forget
# otherwise, so the trigger is mechanical. fd.rs and engine.rs are excluded
# from the trigger: their tests are the ones Miri refuses (real fd machinery),
# so an instrument run there buys nothing — they are covered by the
# integration suites on the real machine instead.
PURE_TOUCHED=$(git diff --cached --name-only --diff-filter=ACMR -- engine/qimgv-engine \
    | grep -vE '(watcher/fd\.rs|src/engine\.rs)' || true)
if [ -n "$PURE_TOUCHED" ]; then
    echo "pre-commit: engine pure layer touched — running Miri (~2 min)" >&2
    sh scripts/miri.sh || {
        echo "pre-commit: Miri red — evidence above" >&2
        echo "(fix it, or git commit --no-verify if you truly mean it)" >&2
        exit 1
    }
fi
